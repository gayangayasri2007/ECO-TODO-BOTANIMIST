<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_botanical_widget_accent"
            android:alpha="0.85"
            android:contentDescription="Botanical Accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="THIS WEEK"
            android:textColor="@color/widget_text_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_stats_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="84% done"
            android:textColor="@color/widget_text_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content Area -->
    <LinearLayout
        android:id="@+id/widget_stats_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top summary row: Count + Streak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_stats_completed_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="completed"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_stats_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 5 d"
                android:textColor="@color/widget_text_terracotta"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/widget_divider" />

        <!-- 7-Day Visual Breakdown (Mon - Sun) -->
        <LinearLayout
            android:id="@+id/widget_stats_chart_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Mon -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day_val_mon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/widget_text_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_day_bar_mon"
                    android:layout_width="12dp"
                    android:layout_height="16dp"
                    android:layout_marginVertical="2dp"
                    android:src="@drawable/bg_widget_bar_active"
                    android:contentDescription="Mon bar" />

                <TextView
                    android:id="@+id/widget_day_lbl_mon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Tue -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day_val_tue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/widget_text_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_day_bar_tue"
                    android:layout_width="12dp"
                    android:layout_height="22dp"
                    android:layout_marginVertical="2dp"
                    android:src="@drawable/bg_widget_bar_active"
                    android:contentDescription="Tue bar" />

                <TextView
                    android:id="@+id/widget_day_lbl_tue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Wed -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day_val_wed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/widget_text_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_day_bar_wed"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginVertical="2dp"
                    android:src="@drawable/bg_widget_bar_active"
                    android:contentDescription="Wed bar" />

                <TextView
                    android:id="@+id/widget_day_lbl_wed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="W"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Thu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day_val_thu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/widget_text_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_day_bar_thu"
                    android:layout_width="12dp"
                    android:layout_height="26dp"
                    android:layout_marginVertical="2dp"
                    android:src="@drawable/bg_widget_bar_active"
                    android:contentDescription="Thu bar" />

                <TextView
                    android:id="@+id/widget_day_lbl_thu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Fri -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day_val_fri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/widget_text_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_day_bar_fri"
                    android:layout_width="12dp"
                    android:layout_height="16dp"
                    android:layout_marginVertical="2dp"
                    android:src="@drawable/bg_widget_bar_active"
                    android:contentDescription="Fri bar" />

                <TextView
                    android:id="@+id/widget_day_lbl_fri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="F"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Sat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day_val_sat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/widget_text_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_day_bar_sat"
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_marginVertical="2dp"
                    android:src="@drawable/bg_widget_bar_active"
                    android:contentDescription="Sat bar" />

                <TextView
                    android:id="@+id/widget_day_lbl_sat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Sun -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day_val_sun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/widget_text_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_day_bar_sun"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginVertical="2dp"
                    android:src="@drawable/bg_widget_bar_active"
                    android:contentDescription="Sun bar" />

                <TextView
                    android:id="@+id/widget_day_lbl_sun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/widget_stats_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No completed tasks yet."
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Start your week."
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
