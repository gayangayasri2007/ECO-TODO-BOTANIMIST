<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- TASK CONTAINER (Banner Card) -->
    <LinearLayout
        android:id="@+id/widget_item_task_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:layout_marginVertical="3dp"
        android:background="@drawable/bg_widget_item_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="7dp"
        android:paddingHorizontal="8dp">

        <!-- Checkbox clickable target -->
        <TextView
            android:id="@+id/widget_item_check"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="☐"
            android:textColor="@color/widget_text_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Timeline / Time marker -->
        <TextView
            android:id="@+id/widget_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Title and Badges -->
        <LinearLayout
            android:id="@+id/widget_item_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_item_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Chevron Clickable Target to Expand/Collapse -->
        <TextView
            android:id="@+id/widget_item_chevron"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="▼"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SUBTASK CONTAINER (Indented Banner Card) -->
    <LinearLayout
        android:id="@+id/widget_item_subtask_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="2dp"
        android:layout_marginVertical="2dp"
        android:background="@drawable/bg_widget_subtask_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingVertical="5dp"
        android:paddingRight="8dp">

        <!-- Subtask Checkbox -->
        <TextView
            android:id="@+id/widget_item_subtask_check"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="☐"
            android:textColor="@color/widget_text_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Subtask Title -->
        <TextView
            android:id="@+id/widget_item_subtask_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
